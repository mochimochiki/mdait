{
  "name": "mdait",
  "displayName": "mdait",
  "description": "%mdait.description%",
  "version": "0.0.1",
  "publisher": "mochimochiki",
  "engines": {
    "vscode": "^1.99.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mochimochiki/mdait.git"
  },
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdait.sync",
        "title": "%mdait.sync.title%"
      },
      {
        "command": "mdait.trans",
        "title": "%mdait.trans.title%"
      },
      {
        "command": "mdait.translate.directory",
        "title": "%mdait.translate.directory.title%",
        "icon": "$(play)",
        "category": "mdait"
      },
      {
        "command": "mdait.translate.file",
        "title": "%mdait.translate.file.title%",
        "icon": "$(play)",
        "category": "mdait"
      },
      {
        "command": "mdait.translate.unit",
        "title": "%mdait.translate.unit.title%",
        "icon": "$(play)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.detect",
        "title": "%mdait.term.detect.title%",
        "icon": "$(repo)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.detect.directory",
        "title": "%mdait.term.detect.directory.title%",
        "icon": "$(repo)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.detect.file",
        "title": "%mdait.term.detect.file.title%",
        "icon": "$(repo)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.expand",
        "title": "%mdait.term.expand.title%",
        "icon": "$(repo-clone)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.expand.directory",
        "title": "%mdait.term.expand.directory.title%",
        "icon": "$(repo-clone)",
        "category": "mdait"
      },
      {
        "command": "mdait.term.expand.file",
        "title": "%mdait.term.expand.file.title%",
        "icon": "$(repo-clone)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.selectTargets",
        "title": "%mdait.status.selectTargets.title%",
        "icon": "$(filter)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.sync",
        "title": "%mdait.status.sync.title%",
        "icon": "$(sync)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.sync.initial",
        "title": "%mdait.status.sync.initial.title%",
        "icon": "$(sync)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.sync.processing",
        "title": "%mdait.status.sync.title%",
        "icon": "$(sync~spin)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.openTerm",
        "title": "%mdait.status.openTerm.title%",
        "icon": "$(repo)",
        "category": "mdait"
      },
      {
        "command": "mdait.status.openTm",
        "title": "%mdait.status.openTm.title%",
        "icon": "$(database)",
        "category": "mdait"
      },
      {
        "command": "mdait.setup.createConfig",
        "title": "%mdait.setup.createConfig.title%",
        "icon": "$(gear)",
        "category": "mdait"
      },
      {
        "command": "mdait.translateSelection",
        "title": "%mdait.translateSelection.title%",
        "category": "mdait"
      },
      {
        "command": "mdait.translate.frontmatter",
        "title": "%mdait.translate.frontmatter.title%",
        "icon": "$(play)",
        "category": "mdait"
      },
      {
        "command": "mdait.tm.commit.file",
        "title": "%mdait.tm.commit.file.title%",
        "icon": "$(database)",
        "category": "mdait"
      },
      {
        "command": "mdait.tm.commit.directory",
        "title": "%mdait.tm.commit.directory.title%",
        "icon": "$(database)",
        "category": "mdait"
      },
      {
        "command": "mdait.tm.optimize",
        "title": "%mdait.tm.optimize.title%",
        "icon": "$(sparkle)",
        "category": "mdait"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdait",
          "title": "%mdait.viewsContainer.title%",
          "icon": "$(globe)"
        }
      ]
    },
    "views": {
      "mdait": [
        {
          "id": "mdait.status",
          "icon": "$(check)",
          "name": "%mdait.status.view.title%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdait.status",
        "contents": "%mdait.welcome.message%",
        "when": "workspaceFolderCount != 0 && !mdaitConfigured"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "mdait.translateSelection",
          "when": "editorHasSelection && mdaitConfigured",
          "group": "mdait@1"
        }
      ],
      "view/title": [
        {
          "command": "mdait.status.selectTargets",
          "when": "view == mdait.status && mdaitConfigured && mdaitHasStatus",
          "group": "navigation@-1"
        },
        {
          "command": "mdait.status.sync.initial",
          "when": "view == mdait.status && mdaitConfigured && !mdaitHasStatus",
          "group": "navigation"
        },
        {
          "command": "mdait.status.sync",
          "when": "view == mdait.status && mdaitConfigured && mdaitHasStatus && !mdaitSyncProcessing",
          "group": "navigation"
        },
        {
          "command": "mdait.status.sync.processing",
          "when": "view == mdait.status && mdaitConfigured && mdaitHasStatus && mdaitSyncProcessing",
          "group": "navigation"
        },
        {
          "command": "mdait.status.openTerm",
          "when": "view == mdait.status && mdaitConfigured && mdaitHasStatus",
          "group": "navigation"
        },
        {
          "command": "mdait.status.openTm",
          "when": "view == mdait.status && mdaitConfigured && mdaitHasStatus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "mdait.translate.directory",
          "when": "view == mdait.status && (viewItem == mdaitDirectoryTarget || viewItem == mdaitDirectoryTargetComplete)",
          "group": "inline"
        },
        {
          "command": "mdait.translate.file",
          "when": "view == mdait.status && (viewItem == mdaitFileTarget || viewItem == mdaitFileTargetComplete)",
          "group": "inline"
        },
        {
          "command": "mdait.translate.unit",
          "when": "view == mdait.status && viewItem == mdaitUnitTarget",
          "group": "inline"
        },
        {
          "command": "mdait.term.detect.directory",
          "when": "view == mdait.status && viewItem == mdaitDirectorySource",
          "group": "inline@1"
        },
        {
          "command": "mdait.term.detect.file",
          "when": "view == mdait.status && viewItem == mdaitFileSource",
          "group": "inline@1"
        },
        {
          "command": "mdait.term.expand.directory",
          "when": "view == mdait.status && viewItem == mdaitDirectoryTargetComplete",
          "group": "inline@2"
        },
        {
          "command": "mdait.term.expand.file",
          "when": "view == mdait.status && viewItem == mdaitFileTargetComplete",
          "group": "inline@2"
        },
        {
          "command": "mdait.translate.frontmatter",
          "when": "view == mdait.status && viewItem == mdaitFrontmatterTarget",
          "group": "inline"
        },
        {
          "command": "mdait.tm.commit.directory",
          "when": "view == mdait.status && viewItem == mdaitDirectoryTargetComplete",
          "group": "inline@3"
        },
        {
          "command": "mdait.tm.commit.file",
          "when": "view == mdait.status && viewItem == mdaitFileTargetComplete",
          "group": "inline@3"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "mdait_getStatus",
        "displayName": "mdait: Get Translation Status",
        "toolReferenceName": "mdaitStatus",
        "modelDescription": "Get the current translation status of the mdait-managed Markdown documents in the workspace. Returns a summary of translation progress including total units, translated units, and files needing translation. Optionally pass a filePath to get status for a specific file.",
        "canBeReferencedInPrompt": true,
        "tags": [
          "mdait",
          "translation",
          "status"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Optional file path to get status for a specific file. If omitted, returns overall status."
            }
          }
        }
      },
      {
        "name": "mdait_sync",
        "displayName": "mdait: Sync Translation Markers",
        "toolReferenceName": "mdaitSync",
        "modelDescription": "Synchronize translation markers in mdait-managed Markdown documents. Detects changes in source documents and updates need flags (need:translate or need:revise@{oldhash}) in target documents. This modifies files by updating HTML comment markers.",
        "canBeReferencedInPrompt": true,
        "tags": [
          "mdait",
          "translation",
          "sync"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "mdait_translate",
        "displayName": "mdait: Translate File",
        "toolReferenceName": "mdaitTranslate",
        "modelDescription": "Translate a Markdown file using AI. Translates units that have need:translate or need:revise flags. The file must be a target file managed by mdait. Uses diff-aware revision for changed content to preserve existing translations.",
        "canBeReferencedInPrompt": true,
        "tags": [
          "mdait",
          "translation",
          "ai"
        ],
        "inputSchema": {
          "type": "object",
          "required": [
            "filePath"
          ],
          "properties": {
            "filePath": {
              "type": "string",
              "description": "The file path of the target Markdown file to translate."
            }
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/.mdait/mdait.json",
        "url": "./assets/schemas/mdait-config.schema.json"
      }
    ],
    "configuration": {
      "title": "%mdait.configuration.title%",
      "properties": {
        "mdait.logLevel": {
          "type": "string",
          "default": "INFO",
          "enum": [
            "DEBUG",
            "INFO",
            "WARN",
            "ERROR"
          ],
          "description": "%mdait.logLevel.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "lint": "biome lint --config-path .config ./src",
    "test": "npm run test:unit",
    "test:unit": "npm run compile && npm run lint && mocha --config .config/.mocharc.json --ui tdd \"out/test/core/**/*.test.js\" \"out/test/utils/logger.test.js\" \"out/test/commands/sync/{marker-sync,section-matcher-no-heading,current-primary-unit-collector,sync-frontmatter-content}.test.js\" \"out/test/commands/term/{term-entry,term-entry-converter,unit-pair}.test.js\" \"out/test/commands/tm/{commit-filter,commit-processor}.test.js\" \"out/test/commands/trans/{output-sanitizer,response-validator,term-extractor,trans-frontmatter,trans-tm-lookup,translation-checker}.test.js\"",
    "test:vscode": "rimraf out/test-gui out/test && npm run compile && npm run lint && vscode-test --config .config/.vscode-test.mjs",
    "watch": "tsc -watch -p ./",
    "copy-test-files": "rimraf ./src/test/workspace/content && node -e \"require('node:fs').cpSync('./src/test/sample-content', './src/test/workspace/content', { recursive: true, force: true })\"",
    "l10n": "npx @vscode/l10n-dev export --outDir ./l10n ./src",
    "l10n-validate": "npx @vscode/l10n-dev validate ./l10n"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "diff": "^8.0.2",
    "fast-xml-parser": "^5.3.4",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "ollama": "^0.6.0",
    "openai": "^4.78.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/diff": "^7.0.2",
    "@types/markdown-it": "^14.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.73.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "madge": "^8.0.0",
    "mocha": "^11.3.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "madge": {
    "fileExtensions": [
      "ts",
      "tsx"
    ],
    "tsConfig": "./tsconfig.json",
    "detectiveOptions": {
      "ts": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      },
      "tsx": {
        "skipAsyncImports": true,
        "skipTypeImports": true
      }
    }
  }
}
