{
  "transPairs": [
    {
      "sourceLang": "ja",
      "sourceDir": "docs",
      "targetLang": "en",
      "targetDir": "i18n/en"
    }
  ],
  "ai": {
    "provider": "vscode-lm",
    "model": "gpt-4o"
  },
  "trans": {
    "contextSize": 1,
    "retryLimit": 1,
    "frontmatter": {
      "keys": ["title", "description"]
    }
  },
  "primaryLang": "ja",
  "sync": {
    "level": 3,
    "autoDelete": true,
    "autoSyncOnSave": true
  },
  "tm": {
    "retryLimit": 1,
    "maxReferences": 5
  },
  "terms": {
    "filename": "terms.csv"
  }
}
